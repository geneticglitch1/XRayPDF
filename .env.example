# XRayPDF needs no configuration to run: it has no database, no auth and no
# server-side processing. Both values below are optional conveniences for
# docker compose, and the app itself reads neither.

# Published image to run. Override to pin a tag or digest, e.g.
# ghcr.io/geneticglitch1/xraypdf:v1.2.0
XRAY_IMAGE=ghcr.io/geneticglitch1/xraypdf:latest

# Host port the app is published on (the container always listens on 3000).
HOST_PORT=3000
