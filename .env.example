# Copy to .env at the repo root before running `docker compose up`.
# Do NOT commit the real .env.

# --- Postgres (compose `postgres` service) ---
POSTGRES_USER=xray
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xray

# --- App (compose `xray` service) ---
# Must match the POSTGRES_* values above; host is the compose service name.
DATABASE_URL=postgresql://xray:change-me@postgres:5432/xray?schema=public

# NextAuth (v4)
NEXTAUTH_SECRET=generate-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Where uploads + result images are stored inside the container (volume mount).
STORAGE_DIR=/app/storage

# --- Deployment knobs ---
# Published image to run. Override to pin a tag or digest, e.g.
# ghcr.io/geneticglitch1/xraypdf:v1.2.0
XRAY_IMAGE=ghcr.io/geneticglitch1/xraypdf:latest
# Host port the app is published on (container always listens on 3000).
HOST_PORT=3000
